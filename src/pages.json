  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "画匣子",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff",
    "maxWidth": 700,
    /* 2026-09-14：rpx 换算基准必须钉死到版心宽度，且**只有写在这里才生效** ——
       uni-h5 的 checkMaxWidth() 是 `const config = __uniConfig.globalStyle`（源码第 3190 行），
       读的是 pages.json 的 globalStyle，不是 manifest.json 的 h5 段。

       不设的话 maxWidth 默认 960、baseWidth 默认 375，换算公式（源码第 3210 行）是
         width = (number === includeWidth || width <= maxWidth) ? width : baseWidth
       于是：窗口 1325px → 走 baseWidth=375 → 750rpx=375px，可版心是 480px（内容偏小）；
             窗口 800px  → 800<=960 成立 → 750rpx=800px，版心仍 480px（内容爆框、突然变巨大）。
       实测证据：改前在 1325px 窗口下量 `.tab-content` 的 600rpx = 300px，即 1rpx=0.5px=375/750。

       设成 480/480 后：窗口 >480 恒定 750rpx=480px（正好等于版心）；
                        窗口 <=480 按真实窗口宽算（真手机全宽）。在 480 这个点连续，无跳变。*/
    "rpxCalcMaxDeviceWidth": 480,
    "rpxCalcBaseDeviceWidth": 480,
    "h5": {
      "titleNView": false
    }
  }
}
